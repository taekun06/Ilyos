{
  "name": "ilyos",
  "version": "0.0.0",
  "private": true,
  "description": "ILYOS — jeu de plateau 3D dans le navigateur. Le jeu lui-même est un site statique sans dépendance : ce package.json ne sert qu'à l'outillage (serveur de développement, build des fragments, tests de bout en bout).",
  "license": "UNLICENSED",
  "scripts": {
    "start": "node scripts/dev-server.js",
    "dev": "node scripts/dev.js",
    "doctor": "node scripts/doctor.js",
    "check": "npm run build:check && node scripts/check-syntax.js",
    "assets:audit": "node scripts/audit-assets.js",
    "build": "node scripts/build-game.js --write",
    "build:check": "node scripts/build-game.js",
    "test": "playwright test",
    "test:smoke": "playwright test tests/tutorial-discovery-smoke.spec.js tests/camera-partie-solo.spec.js --project=chromium --timeout=120000",
    "test:ui": "playwright test --ui",
    "test:headed": "playwright test --headed",
    "empreinte": "node scripts/empreinte-css.js relever",
    "empreinte:comparer": "node scripts/empreinte-css.js comparer",
    "audit:important": "node scripts/audit-important.js",
    "test:install": "playwright install --with-deps chromium"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1"
  }
}
